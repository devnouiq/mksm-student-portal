    "zod": "^3.24.1",
    "zod-to-json-schema": "^3.25.2"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "^19",
    "drizzle-kit": "^0.28.1",
    "eslint": "^9",
