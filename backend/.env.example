# ---------------------------------------------------------------------------
# MKSM backend environment. Copy to `.env.local` (gitignored) and fill in.
# `src/lib/config.ts` validates these at startup and crashes fast if invalid.
# ---------------------------------------------------------------------------

# Node env
NODE_ENV=development

# --- Database (Supabase Postgres) ------------------------------------------
# Session pooler connection string (Supabase Dashboard -> Connect -> Session pooler).
# The direct db.<ref>.supabase.co host is IPv6-only; use the pooler.
DATABASE_URL=postgresql://postgres.tsevnkhqtfynafajmobv:YOUR_DB_PASSWORD@aws-0-ap-northeast-2.pooler.supabase.com:5432/postgres

# Max pooled connections held by this service (keep low; pooler is shared).
DATABASE_POOL_MAX=5
# Per-statement timeout in milliseconds.
DATABASE_STATEMENT_TIMEOUT_MS=15000

# --- Supabase Auth / Storage ---------------------------------------------
SUPABASE_URL=https://tsevnkhqtfynafajmobv.supabase.co
# Public anon key — safe to expose; used for password-grant login.
SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
# Service role key — SECRET. Never send to a browser, never log. Bypasses RLS.
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY

# --- App ----------------------------------------------------------------
# Comma-separated list of origins allowed to call the API (the frontend URL).
CORS_ALLOWED_ORIGINS=http://localhost:3000
# Homework must be submitted at least this many days before the next class (PRD 8.7).
HOMEWORK_CUTOFF_DAYS=2
# Log level: trace|debug|info|warn|error
LOG_LEVEL=info

# --- Tests -------------------------------------------------------------
# Set to 1 to enable integration tests that run migrations + seed against the
# database in DATABASE_URL. Leave unset in normal development.
# MKSM_TEST_DB=1
