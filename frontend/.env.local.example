# ---------------------------------------------------------------------------
# Frontend environment — copy to `frontend/.env.local` (gitignored).
# SAFE TO SHARE with the frontend team. Contains only public values:
# no database URL, no service_role key, no secrets.
# ---------------------------------------------------------------------------

# --- Data source --------------------------------------------------------
# The seam in frontend/src/data/index.ts. Leave as "mock" until the HTTP
# repository implementation lands; switch to "api" to hit the real backend.
MKSM_DATA_SOURCE=mock

# Base URL of the backend API (backend/ workspace).
#   local dev:  http://localhost:3001
#   staging:    https://<your-backend-host>
MKSM_API_URL=http://localhost:3001

# If any client component needs to read these directly, also expose them with
# the NEXT_PUBLIC_ prefix (Next only ships NEXT_PUBLIC_* to the browser):
NEXT_PUBLIC_MKSM_API_URL=http://localhost:3001

# --- Supabase (client, for session handling only) --------------------
# The anon key is PUBLIC by design — it is safe in the browser and safe to
# share. Row-level security on every table is what protects the data.
# Get it: Supabase Dashboard -> Project Settings -> API -> "anon" "public".
NEXT_PUBLIC_SUPABASE_URL=https://tsevnkhqtfynafajmobv.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=REPLACE_WITH_SUPABASE_ANON_KEY

# --- Existing mock knob (frontend M1) --------------------------------
# Artificial latency for the in-memory mock so loading states are visible.
# MKSM_MOCK_LATENCY_MS=250

# ---------------------------------------------------------------------------
# NEVER put these in the frontend env (backend-only, they live in
# backend/.env.local):
#   DATABASE_URL                 (contains the DB password)
#   SUPABASE_SERVICE_ROLE_KEY    (bypasses RLS — full DB access)
# ---------------------------------------------------------------------------
